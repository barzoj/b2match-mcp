{
  "name": "b2match-mcp",
  "version": "0.2.2",
  "mcpName": "io.github.barzoj/b2match-mcp",
  "description": "Read-only MCP server for the B2match event and matchmaking platform",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "b2match-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "B2MATCH_LIVE_SMOKE=1 vitest run tests/live-smoke.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barzoj/b2match-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "b2match",
    "matchmaking",
    "events"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/barzoj/b2match-mcp/issues"
  },
  "homepage": "https://github.com/barzoj/b2match-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "graphql": "^17.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
